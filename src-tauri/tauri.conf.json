{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": null,
    "beforeDevCommand": null,
    "devPath": "http://localhost:20128",
    "distDir": "../build"
  },
  "package": {
    "productName": "One",
    "version": "0.5.4"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "scope": ["$APPCONFIG/**", "$APPDATA/**", "$HOME/**"]
      },
      "path": {
        "all": true
      },
      "os": {
        "all": true
      },
      "window": {
        "all": true
      },
      "menu": {
        "all": true
      },
      "tray": {
        "all": true
      },
      "process": {
        "all": true,
        "exit": true,
        "relaunch": true
      },
      "app": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "dmg"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "identifier": "com.one.desktop",
      "category": "DeveloperTools",
      "shortDescription": "One Desktop App",
      "longDescription": "One - A powerful AI management platform",
      "copyright": "Copyright © 2024 One",
      "resources": [
        "resources/**"
      ],
      "externalBin": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "One",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "url": "http://localhost:20128"
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "title": "One"
    }
  }
}
